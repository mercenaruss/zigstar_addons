#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start universal-silabs-flasher
# ==============================================================================

set -e

declare device
declare network_device
declare bootloader_baudrate
declare firmware_url
declare workdir
declare exit_status
declare -a flasher_args

workdir=$(mktemp -d)

function cleanup() {
    exit_status=$?
    rm -rf "${workdir}"
    bashio::log.info "universal-silabs-flasher-up script exited with code ${exit_status}"
    echo "${exit_status}" > /run/s6-linux-init-container-results/exitcode

    /run/s6/basedir/bin/halt
}
trap cleanup EXIT

network_device=$(bashio::config 'network_device')

if bashio::config.true 'device_type'; then
    device=$(bashio::config 'device')
else
    device="socket://${network_device}"
fi

bootloader_baudrate=$(bashio::config 'bootloader_baudrate')

if ! bashio::config.has_value 'firmware_url'; then
    bashio::log.error "No firmware URL provided"
    exit 1
fi

firmware_url=$(bashio::config 'firmware_url')
bashio::log.info "Downloading firmware from ${firmware_url}"
if ! curl --silent --show-error --fail --location \
        --proto '=https' --retry 3 --max-time 120 \
        -o "${workdir}/firmware.gbl" "${firmware_url}"; then
    bashio::log.error "Downloading firmware failed"
    exit 1
fi

if [ ! -s "${workdir}/firmware.gbl" ]; then
    bashio::log.error "Downloaded firmware is empty"
    exit 1
fi

flasher_args=()
if bashio::config.true 'verbose'; then
    flasher_args+=("-v")
fi
flasher_args+=(--device "${device}" --bootloader-baudrate "${bootloader_baudrate}")

bashio::log.info "Starting universal-silabs-flasher with ${device} (bootloader baudrate ${bootloader_baudrate})"
universal-silabs-flasher "${flasher_args[@]}" \
    flash --force --firmware "${workdir}/firmware.gbl"
